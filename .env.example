# Database
DATABASE_URL="postgresql://user:password@localhost:5432/dbname?schema=public"

# Vercel / Prisma (Local Fallbacks)
POSTGRES_URL="postgresql://user:password@localhost:5432/dbname?schema=public"
PRISMA_DATABASE_URL="postgresql://user:password@localhost:5432/dbname?schema=public"

# Uploadthing
UPLOADTHING_TOKEN="your_uploadthing_token_here"

# Resend API
RESEND_API_KEY="re_your_api_key_here"

# Optional Contact Settings (Overrides)
# CONTACT_TO_EMAIL="info@etssmart.com"
# CONTACT_FROM_EMAIL="info@etssmart.com"

# Google Gemini API
GOOGLE_GENERATIVE_AI_API_KEY="your_gemini_api_key_here"

# Google Analytics (GA4) ID
NEXT_PUBLIC_GA_ID="your_ga4_measurement_id_here"

# Admin login (generate both values with: npm run hash-password -- "YourStrongPassword")
ADMIN_USERNAME="admin-username-here"
ADMIN_PASSWORD_HASH="scrypt:<salt>:<hash>"
SESSION_SECRET="random-string-of-at-least-32-characters"

# Optional: shared rate limiting across serverless instances (Upstash Redis via Vercel Marketplace)
# UPSTASH_REDIS_REST_URL="https://xxxx.upstash.io"
# UPSTASH_REDIS_REST_TOKEN="your_upstash_token"

# Optional: override the Gemini models used by the chatbot
# GEMINI_CHAT_MODEL="gemini-flash-latest"
# GEMINI_EMBEDDING_MODEL="gemini-embedding-001"
